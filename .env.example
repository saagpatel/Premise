# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (recommended for auth callbacks)
NEXT_PUBLIC_APP_URL=

# AI Classifier (optional - app works without it)
ANTHROPIC_API_KEY=

# Ollama fallback (optional, local dev only)
OLLAMA_URL=
OLLAMA_MODEL=

# Sentry (error monitoring - set these in Vercel project env vars)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
